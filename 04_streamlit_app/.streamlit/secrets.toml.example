# Snowflake credentials - DO NOT COMMIT THIS FILE
# Copy this to secrets.toml and fill in your credentials
# Add secrets.toml to .gitignore
# For production, use Streamlit Cloud's Secrets Management

[snowflake]
user = "your_username"
password = "your_password"
account = "your_account.region"  # e.g., "VMLGBTX-DU47606"
warehouse = "COMPUTE_WH"
database = "BLUESKY_DB"
schema = "MAIN"
role = "DEV_FR"  # or "ADMIN_FR" for elevated privileges
